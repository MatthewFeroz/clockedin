{
  "name": "clockedin",
  "private": true,
  "version": "0.1.0",
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "bun run desktop:rebuild-native",
    "build": "bun run typecheck && bun run --cwd apps/desktop build",
    "dev": "bun run --cwd apps/desktop dev",
    "desktop:dev": "bun run --cwd apps/desktop dev",
    "desktop:rebuild-native": "bun run --cwd apps/desktop rebuild:native",
    "test": "bun x vitest run",
    "typecheck": "bun run --cwd packages/shared typecheck && bun run --cwd packages/storage typecheck && bun run --cwd apps/desktop typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
