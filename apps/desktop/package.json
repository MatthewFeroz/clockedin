{
  "name": "@clockedin/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "build": "node ./scripts/run-electron-vite.mjs build",
    "dev": "node ./scripts/run-electron-vite.mjs dev",
    "preview": "node ./scripts/run-electron-vite.mjs preview",
    "rebuild:native": "node ./node_modules/.bin/electron-rebuild -f -w better-sqlite3 -v 37.5.0",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@clockedin/shared": "workspace:*",
    "@clockedin/storage": "workspace:*",
    "better-sqlite3": "^12.4.1",
    "electron-updater": "^6.6.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^37.5.0",
    "electron-vite": "^4.0.0",
    "vite": "^7.1.7"
  }
}
